# Required to change selectors over the API. Without it the app generates a random
# key at startup and prints it, so the API is never left open.
#
#   openssl rand -base64 24
SHOP_API_KEY=

# Optional: a separate random signing key to preserve admin sessions across restarts.
# If empty, a fresh session-signing key is generated at startup.
SHOP_SESSION_SECRET=

# Set to 1 when serving over HTTPS. Leave 0 for the local HTTP preview.
SHOP_SECURE_COOKIES=0

# Port published on the host. Defaults to 8811.
PORT=8811
